{
  "name": "aerorf-packages",
  "version": "1.0.0",
  "private": true,
  "description": "Pacotes compartilhados AeroRF — @aerorf/shared e @aerorf/business-rules",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @aerorf/shared && npm run build -w @aerorf/business-rules",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage -w @aerorf/business-rules",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AeroRF/aerorf-packages.git"
  }
}
